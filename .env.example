# ---------------------------------------------------------------
# Supabase (database, auth, photo storage)
# Project settings -> API. These two are PUBLIC by design (they are
# shipped to the browser); all data is protected by Row Level Security.
# Leave both empty to run the app in "this device only" mode.
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# AI fish identification (server-side only — NEVER prefix with NEXT_PUBLIC_)
# Get a key at https://console.anthropic.com  -> API Keys
# Without it, the "Identify with AI" button explains that AI is not
# configured and manual species selection keeps working.
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Only for local development without Supabase: allow the AI endpoint to be
# called without a signed-in user. Never enable this on a public deployment.
# AI_ALLOW_ANONYMOUS=false
